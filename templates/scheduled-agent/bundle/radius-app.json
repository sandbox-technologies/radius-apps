{
  "schemaVersion": 2,
  "apiVersion": "radius.apps/1",
  "id": "dev.radius.template.scheduled-agent",
  "name": "Daily Report",
  "version": "0.1.0",
  "description": "A restricted previous-local-day report descriptor. Native generation is currently unavailable.",
  "instances": { "mode": "single", "stateSchemaVersion": 1 },
  "configurationSchema": {
    "type": "object",
    "properties": {
      "title": { "type": "string", "minLength": 1, "maxLength": 120 },
      "timeZone": { "type": "string", "minLength": 1, "maxLength": 100 }
    },
    "required": ["title", "timeZone"],
    "additionalProperties": false
  },
  "requires": {
    "activity": { "capability": "activity.read", "scope": { "source": "conversation-metadata", "fields": ["title", "createdAt", "updatedAt"], "days": 1 } },
    "generation": { "capability": "agent.run", "scope": { "profile": "restricted-generation" } },
    "reports": { "capability": "artifacts.write", "scope": { "owner": "self" } }
  },
  "provides": {
    "actions": {
      "generate": {
        "title": "Generate daily report",
        "contexts": ["app"],
        "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false },
        "outputSchema": {
          "type": "object",
          "properties": { "artifactId": { "type": "string", "minLength": 1 } },
          "required": ["artifactId"],
          "additionalProperties": false
        },
        "requires": ["activity", "generation", "reports"],
        "implementation": {
          "kind": "agent",
          "prompt": "prompts/report.md",
          "profile": "restricted-generation",
          "context": [{ "requirement": "activity", "selector": "previous-local-day" }],
          "result": "html-artifact"
        }
      }
    },
    "views": {},
    "events": {},
    "triggers": {
      "daily": { "kind": "schedule", "action": "generate", "input": {}, "suggested": { "localTime": "09:00" } }
    }
  }
}
