{
  "schemaVersion": 2,
  "apiVersion": "radius.apps/1",
  "id": "dev.radius.morning-brief",
  "name": "Morning Brief",
  "version": "1.1.0",
  "description": "A local dashboard for explicitly running and reviewing briefs from approved previous-local-day conversation metadata. Generation requires an available hard-budget host.",
  "instances": { "mode": "single", "stateSchemaVersion": 1 },
  "configurationSchema": {
    "type": "object",
    "properties": {
      "title": { "type": "string", "minLength": 1, "maxLength": 120 },
      "timeZone": { "type": "string", "minLength": 1, "maxLength": 100 },
      "todayPriorities": { "type": "string", "maxLength": 2000, "description": "Optional user-entered priorities for the next brief, treated as untrusted planning context, not instructions or evidence of past activity. Review or clear these manually; they do not expire automatically." }
    },
    "required": ["title", "timeZone"],
    "additionalProperties": false
  },
  "requires": {
    "activity": { "capability": "activity.read", "scope": { "source": "conversation-metadata", "fields": ["title", "createdAt", "updatedAt"], "days": 1 } },
    "generation": { "capability": "agent.run", "scope": { "profile": "restricted-generation" } },
    "reports": { "capability": "artifacts.write", "scope": { "owner": "self" } },
    "readReports": { "capability": "artifacts.read", "scope": { "owner": "self" } },
    "openReports": { "capability": "artifacts.open", "scope": { "owner": "self" } }
  },
  "provides": {
    "actions": {
      "generate": {
        "title": "Generate Morning Brief",
        "contexts": ["app"],
        "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false },
        "outputSchema": {
          "type": "object",
          "properties": { "artifactId": { "type": "string", "minLength": 1 } },
          "required": ["artifactId"],
          "additionalProperties": false
        },
        "requires": ["activity", "generation", "reports"],
        "implementation": {
          "kind": "agent",
          "prompt": "prompts/brief.md",
          "profile": "restricted-generation",
          "context": [{ "requirement": "activity", "selector": "previous-local-day" }],
          "result": "html-artifact"
        }
      }
    },
    "views": { "main": { "title": "Morning Brief", "entry": "ui/index.html", "placement": "tab" } },
    "events": {},
    "triggers": {
      "morning": { "kind": "schedule", "action": "generate", "input": {}, "suggested": { "localTime": "08:30" } }
    }
  }
}
